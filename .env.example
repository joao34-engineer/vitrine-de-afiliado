# Supabase public browser config
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Server-only Supabase admin key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server-only narrow tracking key. Used only by /r/[productId] record_click.
SUPABASE_CLICK_KEY=YOUR_SUPABASE_CLICK_KEY

# Server-only machine-to-machine key for catalog ingestion and review APIs.
AFFILIATE_VITRINE_INTERNAL_SECRET=YOUR_AFFILIATE_VITRINE_INTERNAL_SECRET

# Affiliate Vitrine
NEXT_PUBLIC_SITE_URL=https://ofertas.salvatbrand.com.br

# Meta Pixel/CAPI intentionally out of V1.
